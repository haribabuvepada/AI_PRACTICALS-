# Map Coloring using Backtracking

colors = ["Red", "Green", "Blue"]

# Map of neighboring regions
graph = {
    "A": ["B", "C"],
    "B": ["A", "C", "D"],
    "C": ["A", "B", "D"],
    "D": ["B", "C"]
}

color = {}


# Check whether the color is safe
def is_safe(region, selected_color):
    for neighbor in graph[region]:
        if neighbor in color and color[neighbor] == selected_color:
            return False
    return True


# Backtracking function
def solve(regions):
    if not regions:
        return True

    region = regions[0]

    for c in colors:
        if is_safe(region, c):
            color[region] = c

            if solve(regions[1:]):
                return True

            # Backtrack
            del color[region]

    return False


# Solve the problem
regions = list(graph.keys())

if solve(regions):
    print("Map Coloring Solution:")
    for region in color:
        print(region, "->", color[region])
else:
    print("No solution exists.")
